# Flask
LOG_LEVEL=INFO
LOG_JSON=0
SECRET_KEY=change-me-to-a-long-random-string
PUBLIC_URL=https://start.example.com

# PocketID (OIDC, authorization code + PKCE). Redirect URI: ${PUBLIC_URL}/api/auth/callback
OIDC_ISSUER=https://id.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Access is restricted to allowed users/groups in PocketID itself.

# Google Weather API key (can also be set from Admin > Settings)
GOOGLE_WEATHER_API_KEY=

# Uptime Kuma (socket.io login with username/password; UI API keys do not work)
KUMA_URL=http://uptime-kuma:3001
KUMA_USERNAME=
KUMA_PASSWORD=
